# Copiar a .env (Docker) o .env.local (npm run dev) y completar.

# URL base de la API de Credinstantes (Laravel), sin barra final
LARAVEL_API_URL=https://tu-dominio-credinstantes/api

# Clave compartida: debe ser igual a RULETA_API_KEY del .env de Laravel
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RULETA_API_KEY=

# Firma la cookie de sesión. Si cambia, todos los promotores deben volver a ingresar.
SESSION_SECRET=

# Solo si la ruleta se sirve por http (sin https): permite la cookie de sesión sin "Secure"
# COOKIE_INSECURE=1
